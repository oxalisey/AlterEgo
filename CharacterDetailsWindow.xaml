<Window x:Class="AlterEgo.CharacterDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alter Ego | Личность"
        Height="750"
        Width="1000"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="InputStyle"
                TargetType="TextBox">
            <Setter Property="Background"
                    Value="#220101"/>
            <Setter Property="Foreground"
                    Value="#D2D2D2"/>
            <Setter Property="BorderBrush"
                    Value="#70252D"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <Style x:Key="ActionButton"
                TargetType="Button">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Background"
                    Value="#641018"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Padding"
                    Value="15,5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="#D2D2D2"/>
            <Setter Property="Margin"
                    Value="5"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Background="#220101">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0"
                Margin="25,20,25,15">
            <TextBlock Text="ALTER EGO"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#D2D2D2"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Расскажи, кем станет твой персонаж"
                       FontSize="14"
                       Foreground="#B98C91"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Основная часть -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="40,0,40,15">

            <StackPanel>

                <!-- Имя -->
                <Border Background="#350707"
                        BorderBrush="#70252D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <TextBlock Text="ИМЯ ПЕРСОНАЖА"
                                   Foreground="#D2D2D2"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBox x:Name="NameInput"
                                 Style="{StaticResource InputStyle}"
                                 Height="40"
                                 MaxLength="100"/>
                    </StackPanel>
                </Border>

                <!-- Характер -->
                <Border Background="#350707"
                        BorderBrush="#70252D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <TextBlock Text="ХАРАКТЕР"
                                   Foreground="#D2D2D2"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Можно выбрать несколько вариантов"
                                   Foreground="#B98C91"
                                   Margin="0,5,0,10"/>

                        <ItemsControl x:Name="TraitsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Свой вариант:"
                                   Foreground="#B98C91"
                                   Margin="0,10,0,5"/>

                        <DockPanel>
                            <Button Content="Добавить"
                                    Click="AddTrait_Click"
                                    Style="{StaticResource ActionButton}"
                                    DockPanel.Dock="Right"
                                    Margin="10,0,0,0"/>

                            <TextBox x:Name="CustomTraitInput"
                                     Style="{StaticResource InputStyle}"
                                     Height="38"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Субкультура -->
                <Border Background="#350707"
                        BorderBrush="#70252D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <TextBlock Text="СУБКУЛЬТУРА"
                                   Foreground="#D2D2D2"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Выбери одну или несколько"
                                   Foreground="#B98C91"
                                   Margin="0,5,0,10"/>

                        <ItemsControl x:Name="SubculturesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Свой вариант:"
                                   Foreground="#B98C91"
                                   Margin="0,10,0,5"/>

                        <DockPanel>
                            <Button Content="Добавить"
                                    Click="AddSubculture_Click"
                                    Style="{StaticResource ActionButton}"
                                    DockPanel.Dock="Right"
                                    Margin="10,0,0,0"/>

                            <TextBox x:Name="CustomSubcultureInput"
                                     Style="{StaticResource InputStyle}"
                                     Height="38"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Увлечения -->
                <Border Background="#350707"
                        BorderBrush="#70252D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <TextBlock Text="УВЛЕЧЕНИЯ"
                                   Foreground="#D2D2D2"
                                   FontSize="17"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Можно выбрать несколько вариантов"
                                   Foreground="#B98C91"
                                   Margin="0,5,0,10"/>

                        <ItemsControl x:Name="HobbiesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Свой вариант:"
                                   Foreground="#B98C91"
                                   Margin="0,10,0,5"/>

                        <DockPanel>
                            <Button Content="Добавить"
                                    Click="AddHobby_Click"
                                    Style="{StaticResource ActionButton}"
                                    DockPanel.Dock="Right"
                                    Margin="10,0,0,0"/>

                            <TextBox x:Name="CustomHobbyInput"
                                     Style="{StaticResource InputStyle}"
                                     Height="38"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Дополнительная информация -->
                <Border Background="#350707"
                        BorderBrush="#70252D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <TextBlock Text="ДОПОЛНИТЕЛЬНАЯ ИНФОРМАЦИЯ"
                                   Foreground="#D2D2D2"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBox x:Name="AdditionalInfoInput"
                                 Style="{StaticResource InputStyle}"
                                 Height="110"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Нижние кнопки -->
        <Grid Grid.Row="2"
                Margin="25,0,25,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Выход -->
            <Button Content="Выйти"
                    Click="Exit_Click"
                    Width="110"
                    Height="38"
                    HorizontalAlignment="Left"
                    Background="#8A1111"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <!-- Назад -->
            <Button Grid.Column="1"
                    Content="Назад"
                    Click="Back_Click"
                    Width="130"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#8A1111"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <!-- Сохранить -->
            <Button Grid.Column="2"
                    Content="Сохранить данные"
                    Click="Save_Click"
                    Width="170"
                    Height="38"
                    Style="{StaticResource ActionButton}"/>
        </Grid>
    </Grid>
</Window>