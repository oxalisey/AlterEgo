<Window x:Class="AlterEgo.CharacterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alter Ego | Гардероб"
        Height="650"
        Width="1000"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">

        <Window.Resources>
        <Style x:Key="WardrobeButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="#641018"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>


    <Grid Background="#220101">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="25,20,25,10">
            <TextBlock Text="ALTER EGO"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#D2D2D2"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Создай свой уникальный образ"
                       FontSize="14"
                       Foreground="#B98C91"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Основная часть -->
        <Grid Grid.Row="1" Margin="25,10,25,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Персонаж -->
            <Border Grid.Column="0"
                    Background="#350707"
                    BorderBrush="#70252D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,15,0">

                <Grid>
                    <TextBlock Text="ТВОЙ ПЕРСОНАЖ"
                               Foreground="#B98C91"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,15,0,0"/>

                    <Image x:Name="CharacterImage"
                           Source="Images/woman.jpg"
                           Stretch="Uniform"
                           Margin="20,45,20,20"/>
                </Grid>
            </Border>

            <!-- Гардероб -->
            <Border Grid.Column="1"
                    Background="#350707"
                    BorderBrush="#70252D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18">

                <StackPanel>
                    <TextBlock Text="ГАРДЕРОБ"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#D2D2D2"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Выбери категорию одежды"
                               FontSize="13"
                               Foreground="#B98C91"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <Button Content="Причёска"
                            Click="Accessories_Click"
                            Style="{StaticResource WardrobeButton}"/>

                    <Button Content="Верхняя одежда"
                            Click="Tops_Click"
                            Style="{StaticResource WardrobeButton}"/>

                    <Button Content="Нижняя одежда"
                            Click="Bottoms_Click"
                            Style="{StaticResource WardrobeButton}"/>

                    <Button Content="Обувь"
                            Click="Shoes_Click"
                            Style="{StaticResource WardrobeButton}"/>

                    <Button Content="Аксессуары"
                            Click="Accessories_Click"
                            Style="{StaticResource WardrobeButton}"/>

                    <Border Background="#220101"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,12,0,0">

                        <TextBlock x:Name="CategoryInfo"
                                   Text="Здесь появятся предметы выбранной категории."
                                   Foreground="#D2D2D2"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Нижняя кнопка -->
        <Button Grid.Row="2"
                Content="Назад"
                Click="Back_Click"
                Width="130"
                Height="35"
                HorizontalAlignment="Left"
                Margin="25,0,0,18"
                Background="#8A1111"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"/>
    </Grid>
</Window>